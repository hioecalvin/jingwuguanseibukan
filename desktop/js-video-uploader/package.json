{
  "name": "js-video-uploader",
  "productName": "JS Video Uploader",
  "version": "0.9.0",
  "private": true,
  "description": "Windows desktop uploader for the Jingwuguan Seibukan Super App",
  "author": "Jingwuguan Seibukan",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:installer-preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/installer-acceptance.ps1 -PreflightOnly",
    "audit:staging-logos": "node scripts/staging-logo-audit.mjs",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1",
    "typescript": "^5"
  },
  "build": {
    "appId": "org.jingwuguanseibukan.video-uploader",
    "productName": "JS Video Uploader",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg/LICENSE.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg/README.txt"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "JSVideoUploader",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "JS-Video-Uploader-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
