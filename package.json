{
  "name": "martial-repository",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "npm run typecheck && node --test scripts/*.test.mjs",
    "test:security": "node scripts/security-smoke.mjs",
    "test:security:staging": "node scripts/run-staging-security-tests.mjs --confirm-staging",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:browser:staging:read-only": "node scripts/staging-browser-smoke.mjs --confirm-staging",
    "recovery:check": "node scripts/recovery-readiness.mjs",
    "recovery:fingerprint": "node scripts/recovery-ledger-fingerprint.mjs",
    "provider:check": "node scripts/provider-config-readiness.mjs",
    "provider:delivery:check": "node scripts/provider-delivery-readiness.mjs",
    "auth-email:staging:preflight": "node scripts/staging-auth-email-readiness.mjs --confirm-offline-preflight",
    "production:target:check": "node scripts/production-target-readiness.mjs",
    "production:bootstrap:check": "node scripts/production-bootstrap-readiness.mjs",
    "production:secrets:check": "node scripts/production-secrets-readiness.mjs",
    "release:window:check": "node scripts/release-window-readiness.mjs",
    "release:evidence:check": "node scripts/release-evidence-packet-readiness.mjs",
    "rollback:check": "node scripts/rollback-readiness.mjs",
    "email-scheduler:check": "node scripts/email-scheduler-readiness.mjs",
    "safari:physical:check": "node scripts/physical-safari-readiness.mjs",
    "production:identity:check": "node scripts/production-identity-readiness.mjs",
    "monitoring:check": "node scripts/monitoring-readiness.mjs",
    "installer:release:check": "node scripts/installer-release-readiness.mjs"
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.13.4",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/qrcode": "^1.5.6",
    "next": "16.3.8",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
